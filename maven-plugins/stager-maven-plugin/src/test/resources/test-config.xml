<stager xmlns="https://helidon.io/stager/1.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://helidon.io/stager/1.0 https://helidon.io/xsd/stager-1.0.xsd">

    <properties>
        <foo>bar</foo>
    </properties>
    <directories>
        <variables>
            <variable name="version">
                <value>${docs.1.version}</value>
                <value>1.4.3</value>
                <value>1.4.2</value>
                <value>1.4.1</value>
                <value>1.4.0</value>
            </variable>
        </variables>
        <directory target="${project.build.directory}/site">
            <unpack-artifacts>
                <unpack-artifact
                        groupId="io.helidon"
                        artifactId="helidon-docs"
                        version="{version}"
                        excludes="META-INF/**"
                        target="docs/{version}">
                    <mappers>
                        <mapper match="^apidocs/(.*)$" replace="$1"/>
                    </mappers>
                    <iterators>
                        <variables>
                            <variable ref="version" />
                        </variables>
                    </iterators>
                </unpack-artifact>
                <unpack-artifact
                        groupId="io.helidon"
                        artifactId="helidon-project"
                        version="{version}"
                        classifier="site"
                        excludes="META-INF/**"
                        target="docs/{version}">
                    <iterators>
                        <variables>
                            <variable name="version">
                                <value>${docs.2.version}</value>
                            </variable>
                        </variables>
                    </iterators>
                </unpack-artifact>
            </unpack-artifacts>
            <symlinks>
                <symlink source="./${docs.latest.version}" target="docs/latest"/>
                <symlink source="./${docs.1.version}" target="docs/v1"/>
                <symlink source="./${docs.2.version}" target="docs/v2"/>
                <symlink source="./${cli.latest.version}" target="cli/latest"/>
            </symlinks>
            <downloads>
                <download url="https://helidon.io/cli-data/{version}/cli-data.zip"
                          target="cli-data/{version}/cli-data.zip">
                    <iterators>
                        <variables>
                            <variable name="version">
                                <value>2.0.0-M1</value>
                            </variable>
                        </variables>
                    </iterators>
                </download>
                <download
                        url="${build-tools.download.url}/{version}/helidon-cli-{platform}-amd64"
                        target="cli/{version}">
                    <iterators>
                        <variables>
                            <variable name="platform">
                                <value>darwin</value>
                                <value>linux</value>
                            </variable>
                            <variable name="version">
                                <value>${cli.latest.version}</value>
                                <value>2.0.0-M4</value>
                            </variable>
                        </variables>
                    </iterators>
                </download>
            </downloads>
            <archives>
                <archive target="cli-data/${cli.data.latest.version}/cli-data.zip">
                    <copy-artifacts>
                        <copy-artifact groupId="io.helidon.archetypes"
                                       artifactId="helidon-archetype-catalog"
                                       version="${cli.data.latest.version}"
                                       type="xml"
                                       target="archetype-catalog.xml"/>
                        <copy-artifact groupId="io.helidon.archetypes"
                                       artifactId="helidon-bare-se"
                                       version="${cli.data.latest.version}" />
                        <copy-artifact groupId="io.helidon.archetypes"
                                       artifactId="helidon-bare-mp"
                                       version="${cli.data.latest.version}" />
                    </copy-artifacts>
                    <templates>
                        <template source="src/cli-metadata.properties.mustache"
                                  target="metadata.properties">
                            <model>
                                <helidonVersion>${cli.data.latest.version}</helidonVersion>
                                <buildToolsVersion>${cli.maven.plugin.version}</buildToolsVersion>
                                <cliVersion>${cli.latest.version}</cliVersion>
                                <cliUpdateMessages>
                                    <major>
                                        <version>2.0.0-M2</version>
                                        <message>Major dev command enhancements</message>
                                    </major>
                                    <archetype>
                                        <version>2.0.0-M4</version>
                                        <message>Helidon archetype support</message>
                                    </archetype>
                                    <performance>
                                        <version>2.0.0-RC1</version>
                                        <message>Performance improvements</message>
                                    </performance>
                                </cliUpdateMessages>
                            </model>
                        </template>
                    </templates>
                </archive>
            </archives>
            <templates>
                <template source="redirect.html.mustache" target="docs/index.html">
                    <model>
                        <location>./latest/index.html</location>
                        <title>Helidon Documentation</title>
                        <description>Helidon Documentation</description>
                        <og-url>https://helidon.io/docs</og-url>
                        <og-description>Documentation</og-description>
                    </model>
                </template>
                <template source="redirect.html.mustache" target="guides/index.html">
                    <model>
                        <location>../docs/latest/index.html#/guides/01_overview</location>
                        <title>Helidon Guides</title>
                        <description>Helidon Guides</description>
                        <og-url>https://helidon.io/guides</og-url>
                        <og-description>Guides</og-description>
                    </model>
                </template>
                <template source="redirect.html.mustache" target="javadocs/index.html">
                    <model>
                        <location>../docs/latest/apidocs/index.html?overview-summary.html</location>
                        <title>Helidon Javadocs</title>
                        <description>Helidon Javadocs</description>
                        <og-url>https://helidon.io/javadocs</og-url>
                        <og-description>Javadocs</og-description>
                    </model>
                </template>
            </templates>
            <files>
                <file target="CNAME">${cname}</file>
                <file target="cli-data/latest">${cli.data.latest.version}</file>
                <file target="sitemap.txt">
                    <list-files dir="docs">
                        <includes>
                            <include>**/foo/**</include>
                            <include>**/bar/**</include>
                        </includes>
                        <excludes>
                            <exclude>**/bob/**</exclude>
                            <exclude>**/alice/**</exclude>
                        </excludes>
                        <substitutions>
                            <substitution
                                    match="^(?&lt;path&gt;([^/]+/)*)index.html$"
                                    replace="{path}" />
                        </substitutions>
                    </list-files>
                </file>
            </files>
            <unpacks>
                <unpack url="https://repo1.maven.org/maven2/com/example/archive/1.0.0/archive-1.0.0.jar"
                        includes="apidocs/**"
                        target="1.0.0">
                    <mappers>
                        <mapper match="^apidocs/(.*)$" replace="$1"/>
                    </mappers>
                </unpack>
            </unpacks>
        </directory>
    </directories>
</stager>
