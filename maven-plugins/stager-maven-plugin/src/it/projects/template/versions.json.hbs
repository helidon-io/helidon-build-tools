{
    "versions": [
    {{#versions}}
        "{{value}}"{{^last}},{{/last}}
    {{/versions}}
    ],
    "preview-versions": [
    {{#preview-versions}}
        {
            "order": {{order}},
            "version": "{{version}}"
        }{{^last}},{{/last}}
    {{/preview-versions}}
    ],
    "latest": "{{latest}}",
    "latest-release": "{{latest-release}}"
}
