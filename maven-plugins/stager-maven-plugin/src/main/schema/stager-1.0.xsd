<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
        targetNamespace="https://helidon.io/stager/1.0"
        xmlns:p="https://helidon.io/stager/1.0"
        elementFormDefault="qualified">

    <xs:element name="stager">
        <xs:annotation>
            <xs:documentation source="description">
                Root element for standalone Helidon Stager Maven Plugin configuration.
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:sequence>
                <xs:group ref="p:preprocessor-include" minOccurs="0" maxOccurs="unbounded"/>
                <xs:element name="properties" type="p:properties-type" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation>
                        <xs:documentation source="description">
                            Container for properties available to ${...} interpolation before staging tasks are created.
                        </xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="variables" type="p:variables-type" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation>
                        <xs:documentation source="description">
                            Variables shared by all effective directory task definitions.
                        </xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="directories" type="p:directories-type" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation>
                        <xs:documentation source="description">
                            Top-level container for directory staging tasks.
                        </xs:documentation>
                    </xs:annotation>
                </xs:element>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:complexType name="properties-type">
        <xs:annotation>
            <xs:documentation source="description">
                Properties available to ${...} interpolation before staging tasks are created.
            </xs:documentation>
        </xs:annotation>
        <xs:choice minOccurs="0" maxOccurs="unbounded">
            <xs:any namespace="##targetNamespace" processContents="skip">
                <xs:annotation>
                    <xs:documentation source="description">
                        Property entry, either named property elements or Maven-style name elements.
                    </xs:documentation>
                </xs:annotation>
            </xs:any>
        </xs:choice>
    </xs:complexType>

    <xs:group name="preprocessor-include">
        <xs:choice>
            <xs:element name="include" type="p:include-directive-type">
                <xs:annotation>
                    <xs:documentation source="description">
                        Include another standalone stager XML file before staging tasks are created.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:choice>
    </xs:group>

    <xs:complexType name="include-directive-type">
        <xs:attribute name="src" type="xs:string" use="required">
            <xs:annotation>
                <xs:documentation source="description">
                    Path to another stager XML file, resolved relative to the including file unless absolute.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
    </xs:complexType>

    <xs:complexType name="directories-type">
        <xs:choice minOccurs="0" maxOccurs="unbounded">
            <xs:element name="variables" type="p:variables-type">
                <xs:annotation>
                    <xs:documentation source="description">
                        Variables shared by nested directory task definitions.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="directory" type="p:directory-type">
                <xs:annotation>
                    <xs:documentation source="description">
                        Generate a directory using nested actions.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="directories" type="p:directories-wrapper-type">
                <xs:annotation>
                    <xs:documentation source="description">
                        Container for directory tasks.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:choice>
        <xs:attribute name="join" type="xs:boolean">
            <xs:annotation>
                <xs:documentation source="description">
                    Executes nested joinable actions sequentially when true.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
    </xs:complexType>

    <xs:group name="nested-actions">
        <xs:choice>
            <xs:element name="variables" type="p:variables-type">
                <xs:annotation>
                    <xs:documentation source="description">
                        Variables shared by nested task definitions.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="directory" type="p:directory-type">
                <xs:annotation>
                    <xs:documentation source="description">
                        Generate a directory using nested actions.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="archive" type="p:archive-type">
                <xs:annotation>
                    <xs:documentation source="description">
                        Generate an archive from nested tasks.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="download" type="p:download-type">
                <xs:annotation>
                    <xs:documentation source="description">
                        Download a file to a target location.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="copy-artifact" type="p:copy-artifact-type">
                <xs:annotation>
                    <xs:documentation source="description">
                        Copy a resolved Maven artifact to a target location.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="copy" type="p:copy-type">
                <xs:annotation>
                    <xs:documentation source="description">
                        Copy project directory contents to a target directory.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="file" type="p:file-type">
                <xs:annotation>
                    <xs:documentation source="description">
                        Generate or copy a file to a target location.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="symlink" type="p:symlink-type">
                <xs:annotation>
                    <xs:documentation source="description">
                        Create a symbolic link.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="template" type="p:template-type">
                <xs:annotation>
                    <xs:documentation source="description">
                        Render a Mustache template to a target file.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="unpack" type="p:unpack-type">
                <xs:annotation>
                    <xs:documentation source="description">
                        Download and unpack an archive to a target directory.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="unpack-artifact" type="p:unpack-artifact-type">
                <xs:annotation>
                    <xs:documentation source="description">
                        Unpack a resolved Maven artifact to a target directory.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="list-files" type="p:list-files-type">
                <xs:annotation>
                    <xs:documentation source="description">
                        List files in a directory and emit the result as text.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="directories" type="p:directories-wrapper-type">
                <xs:annotation>
                    <xs:documentation source="description">
                        Container for directory tasks.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="archives" type="p:archives-wrapper-type">
                <xs:annotation>
                    <xs:documentation source="description">
                        Container for archive tasks.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="downloads" type="p:downloads-wrapper-type">
                <xs:annotation>
                    <xs:documentation source="description">
                        Container for download tasks.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="copy-artifacts" type="p:copy-artifacts-wrapper-type">
                <xs:annotation>
                    <xs:documentation source="description">
                        Container for copy-artifact tasks.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="copies" type="p:copies-wrapper-type">
                <xs:annotation>
                    <xs:documentation source="description">
                        Container for copy tasks.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="files" type="p:files-wrapper-type">
                <xs:annotation>
                    <xs:documentation source="description">
                        Container for file tasks.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="symlinks" type="p:symlinks-wrapper-type">
                <xs:annotation>
                    <xs:documentation source="description">
                        Container for symlink tasks.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="templates" type="p:templates-wrapper-type">
                <xs:annotation>
                    <xs:documentation source="description">
                        Container for template tasks.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="unpacks" type="p:unpacks-wrapper-type">
                <xs:annotation>
                    <xs:documentation source="description">
                        Container for unpack tasks.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="unpack-artifacts" type="p:unpack-artifacts-wrapper-type">
                <xs:annotation>
                    <xs:documentation source="description">
                        Container for unpack-artifact tasks.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:choice>
    </xs:group>

    <xs:group name="iterator-content">
        <xs:choice>
            <xs:element name="iterators" type="p:iterators-type">
                <xs:annotation>
                    <xs:documentation source="description">
                        Iterators nested under a task to create loops over {name} variable substitutions.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:choice>
    </xs:group>

    <xs:group name="mapper-content">
        <xs:choice>
            <xs:element name="mapper" type="p:mapper-type">
                <xs:annotation>
                    <xs:documentation source="description">
                        Archive entry path mapper applied while unpacking.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="mappers" type="p:mappers-type">
                <xs:annotation>
                    <xs:documentation source="description">
                        Container for archive entry path mappers applied while unpacking.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:choice>
    </xs:group>

    <xs:group name="list-files-content">
        <xs:choice>
            <xs:element name="iterators" type="p:iterators-type">
                <xs:annotation>
                    <xs:documentation source="description">
                        Iterators nested under list-files to create loops over {name} variable substitutions.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="include" type="p:text-type">
                <xs:annotation>
                    <xs:documentation source="description">
                        Include pattern for list-files filtering.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="includes" type="p:includes-type">
                <xs:annotation>
                    <xs:documentation source="description">
                        Container for include patterns used by list-files.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="exclude" type="p:text-type">
                <xs:annotation>
                    <xs:documentation source="description">
                        Exclude pattern for list-files filtering.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="excludes" type="p:excludes-type">
                <xs:annotation>
                    <xs:documentation source="description">
                        Container for exclude patterns used by list-files.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="substitution" type="p:substitution-type">
                <xs:annotation>
                    <xs:documentation source="description">
                        Text substitution applied to each list-files result entry.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="substitutions" type="p:substitutions-type">
                <xs:annotation>
                    <xs:documentation source="description">
                        Container for substitutions applied to each list-files result entry.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:choice>
    </xs:group>

    <xs:group name="copy-content">
        <xs:choice>
            <xs:element name="iterators" type="p:iterators-type">
                <xs:annotation>
                    <xs:documentation source="description">
                        Iterators nested under copy to create loops over {name} variable substitutions.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="include" type="p:text-type">
                <xs:annotation>
                    <xs:documentation source="description">
                        Glob-style include filter relative to the copy source directory.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="includes" type="p:includes-type">
                <xs:annotation>
                    <xs:documentation source="description">
                        Container for include filters relative to the copy source directory.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="exclude" type="p:text-type">
                <xs:annotation>
                    <xs:documentation source="description">
                        Glob-style exclude filter relative to the copy source directory.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="excludes" type="p:excludes-type">
                <xs:annotation>
                    <xs:documentation source="description">
                        Container for exclude filters relative to the copy source directory.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:choice>
    </xs:group>

    <xs:complexType name="text-type" mixed="true"/>

    <xs:complexType name="variables-type">
        <xs:sequence>
            <xs:element name="variable" type="p:variable-type" minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:documentation source="description">
                        Variable definition with a name and a value or list of values.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
        <xs:attribute name="join" type="xs:boolean">
            <xs:annotation>
                <xs:documentation source="description">
                    Executes variable-driven work sequentially when true.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
    </xs:complexType>

    <xs:complexType name="iterator-variables-type">
        <xs:sequence>
            <xs:element name="variable" type="p:iterator-variable-type" minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:documentation source="description">
                        Iterator variable whose values are substituted using {name} syntax in task definitions.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
        <xs:attribute name="join" type="xs:boolean">
            <xs:annotation>
                <xs:documentation source="description">
                    Iterates the variables sequentially when true.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
    </xs:complexType>

    <xs:complexType name="variable-type">
        <xs:choice minOccurs="0">
            <xs:element name="value" type="p:value-type" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:documentation source="description">
                        One value for the variable; value children cannot be mixed with variable references.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="variable" type="p:variable-type" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:documentation source="description">
                        Reference to a previously declared list variable whose values are appended to this aggregate.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:choice>
        <xs:attribute name="name" type="xs:string">
            <xs:annotation>
                <xs:documentation source="description">
                    Variable name used by templates or task definitions, or an alias for a referenced variable.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="ref" type="xs:string">
            <xs:annotation>
                <xs:documentation source="description">
                    Reference to an enclosing or earlier sibling variable; ref takes precedence over other content.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="value" type="xs:string">
            <xs:annotation>
                <xs:documentation source="description">
                    Inline variable value used when ref and nested children are absent.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
    </xs:complexType>

    <xs:complexType name="iterator-variable-type">
        <xs:sequence>
            <xs:element name="value" type="p:value-type" minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:documentation source="description">
                        One value for the iterator variable.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
        <xs:attribute name="name" type="xs:string">
            <xs:annotation>
                <xs:documentation source="description">
                    Iterator variable name referenced with {name} syntax, or an alias for a referenced variable.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="ref" type="xs:string">
            <xs:annotation>
                <xs:documentation source="description">
                    Reference to an enclosing or earlier sibling variable; ref takes precedence over other content.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="value" type="xs:string">
            <xs:annotation>
                <xs:documentation source="description">
                    Inline iterator variable value used instead of nested value elements.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
    </xs:complexType>

    <xs:complexType name="value-type" mixed="true">
        <xs:sequence>
            <xs:element name="variable" type="p:variable-type" minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:documentation source="description">
                        Nested variable used to create a map value.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="iterators-type">
        <xs:sequence>
            <xs:element name="variables" type="p:iterator-variables-type" minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:documentation source="description">
                        Iterator variables; multiple variables form a matrix of value combinations.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
        <xs:attribute name="join" type="xs:boolean">
            <xs:annotation>
                <xs:documentation source="description">
                    Executes iterator-driven task invocations sequentially when true.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
    </xs:complexType>

    <xs:complexType name="directory-type">
        <xs:choice minOccurs="0" maxOccurs="unbounded">
            <xs:group ref="p:nested-actions"/>
        </xs:choice>
        <xs:attribute name="target" type="xs:string" use="required">
            <xs:annotation>
                <xs:documentation source="description">
                    Directory path to create relative to the current staging directory.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
    </xs:complexType>

    <xs:complexType name="archive-type">
        <xs:choice minOccurs="0" maxOccurs="unbounded">
            <xs:group ref="p:iterator-content"/>
            <xs:group ref="p:nested-actions"/>
        </xs:choice>
        <xs:attribute name="target" type="xs:string" use="required">
            <xs:annotation>
                <xs:documentation source="description">
                    Archive file path to create relative to the current staging directory.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="includes" type="xs:string">
            <xs:annotation>
                <xs:documentation source="description">
                    Include patterns selecting staged entries to add to the archive.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="excludes" type="xs:string">
            <xs:annotation>
                <xs:documentation source="description">
                    Exclude patterns removing staged entries from the archive.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="join" type="xs:boolean">
            <xs:annotation>
                <xs:documentation source="description">
                    Executes nested joinable actions sequentially when true.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
    </xs:complexType>

    <xs:complexType name="download-type">
        <xs:choice minOccurs="0" maxOccurs="unbounded">
            <xs:group ref="p:iterator-content"/>
        </xs:choice>
        <xs:attribute name="target" type="xs:string" use="required">
            <xs:annotation>
                <xs:documentation source="description">
                    File path where the downloaded content is written.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="url" type="xs:string" use="required">
            <xs:annotation>
                <xs:documentation source="description">
                    URL of the file to download.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="join" type="xs:boolean">
            <xs:annotation>
                <xs:documentation source="description">
                    Executes iterator-driven task invocations sequentially when true.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
    </xs:complexType>

    <xs:complexType name="copy-artifact-type">
        <xs:choice minOccurs="0" maxOccurs="unbounded">
            <xs:group ref="p:iterator-content"/>
        </xs:choice>
        <xs:attribute name="groupId" type="xs:string" use="required">
            <xs:annotation>
                <xs:documentation source="description">
                    Maven artifact groupId.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="artifactId" type="xs:string" use="required">
            <xs:annotation>
                <xs:documentation source="description">
                    Maven artifact artifactId.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="version" type="xs:string" use="required">
            <xs:annotation>
                <xs:documentation source="description">
                    Maven artifact version.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="type" type="xs:string">
            <xs:annotation>
                <xs:documentation source="description">
                    Maven artifact type; defaults to jar.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="classifier" type="xs:string">
            <xs:annotation>
                <xs:documentation source="description">
                    Optional Maven artifact classifier.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="target" type="xs:string">
            <xs:annotation>
                <xs:documentation source="description">
                    File path where the artifact is copied; defaults to {artifactId}-{version}.{type}.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="join" type="xs:boolean">
            <xs:annotation>
                <xs:documentation source="description">
                    Executes iterator-driven task invocations sequentially when true.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
    </xs:complexType>

    <xs:complexType name="copy-type">
        <xs:choice minOccurs="0" maxOccurs="unbounded">
            <xs:group ref="p:copy-content"/>
        </xs:choice>
        <xs:attribute name="source" type="xs:string" use="required">
            <xs:annotation>
                <xs:documentation source="description">
                    Project directory path whose contents are copied.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="target" type="xs:string" use="required">
            <xs:annotation>
                <xs:documentation source="description">
                    Target directory path relative to the current staging directory.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="join" type="xs:boolean">
            <xs:annotation>
                <xs:documentation source="description">
                    Executes iterator-driven task invocations sequentially when true.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
    </xs:complexType>

    <xs:complexType name="file-type" mixed="true">
        <xs:choice minOccurs="0" maxOccurs="unbounded">
            <xs:group ref="p:iterator-content"/>
            <xs:element name="list-files" type="p:list-files-type">
                <xs:annotation>
                    <xs:documentation source="description">
                        List files and write the resulting text into this file.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:choice>
        <xs:attribute name="target" type="xs:string" use="required">
            <xs:annotation>
                <xs:documentation source="description">
                    File path to create or copy to.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="source" type="xs:string">
            <xs:annotation>
                <xs:documentation source="description">
                    Source file path to copy; omitted when creating text file content.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="join" type="xs:boolean">
            <xs:annotation>
                <xs:documentation source="description">
                    Executes iterator-driven task invocations sequentially when true.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
    </xs:complexType>

    <xs:complexType name="symlink-type">
        <xs:choice minOccurs="0" maxOccurs="unbounded">
            <xs:group ref="p:iterator-content"/>
        </xs:choice>
        <xs:attribute name="target" type="xs:string" use="required">
            <xs:annotation>
                <xs:documentation source="description">
